{
  "compilerOptions": {
    "composite": true,
    "rootDir": "..",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "../src/**/*.ts",
    "../src/**/*.d.ts",
    "../src/**/*.vue",
    "../src/**/*.tsx",
    "../tests/unit/**/*.spec.ts"
  ]
}
